{
  "manifest_version": 3,
  "name": "Aeon",
  "version": "0.1.0",
  "description": "Aeon local Chat and browser context.",
  "minimum_chrome_version": "116",
  "key": "",
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Open Aeon Chat"
  },
  "chrome_url_overrides": {
    "newtab": "home.html"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": [
    "nativeMessaging",
    "storage",
    "tabs",
    "sidePanel",
    "debugger",
    "contextMenus",
    "notifications"
  ],
  "host_permissions": ["http://127.0.0.1/*", "https://models.dev/*"]
}
