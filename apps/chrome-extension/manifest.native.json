{
  "manifest_version": 3,
  "name": "Aeon",
  "version": "0.1.0",
  "description": "Aeon local Chat and browser context.",
  "minimum_chrome_version": "125",
  "key": "",
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Open Aeon Chat",
    "default_icon": {
      "16": "aeon-icon-16.png",
      "32": "aeon-icon-32.png",
      "48": "aeon-icon-48.png",
      "128": "aeon-icon-128.png"
    }
  },
  "chrome_url_overrides": {
    "newtab": "home.html"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": [
    "nativeMessaging",
    "storage",
    "tabs",
    "sidePanel",
    "debugger",
    "contextMenus",
    "notifications",
    "userScripts",
    "scripting",
    "webNavigation",
    "downloads",
    "offscreen",
    "tabGroups",
    "history",
    "bookmarks",
    "declarativeNetRequest"
  ],
  "host_permissions": ["http://*/*", "https://*/*"],
  "icons": {
    "16": "aeon-icon-16.png",
    "32": "aeon-icon-32.png",
    "48": "aeon-icon-48.png",
    "128": "aeon-icon-128.png"
  },
  "sandbox": {
    "pages": ["code-sandbox.html"]
  }
}
