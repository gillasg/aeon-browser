{
  "manifest_version": 3,
  "name": "Aeon Slice 2 development fixture",
  "version": "0.0.0",
  "description": "Development-only Aeon browser shell and Chat UI; not a product extension.",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Open Aeon Chat",
    "default_icon": {
      "16": "aeon-icon-16.png",
      "32": "aeon-icon-32.png",
      "48": "aeon-icon-48.png",
      "128": "aeon-icon-128.png"
    }
  },
  "chrome_url_overrides": {
    "newtab": "home.html"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "permissions": [
    "storage",
    "tabs",
    "sidePanel",
    "notifications",
    "userScripts",
    "scripting",
    "webNavigation"
  ],
  "host_permissions": ["http://*/*", "https://*/*"],
  "icons": {
    "16": "aeon-icon-16.png",
    "32": "aeon-icon-32.png",
    "48": "aeon-icon-48.png",
    "128": "aeon-icon-128.png"
  }
}
