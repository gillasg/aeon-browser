{
  "name": "site-boosts",
  "version": "0.1.0",
  "private": true,
  "description": "The boost engine Graft's extension embeds: styles, zaps, actions, network rules and userscripts that keep a site behaving your way.",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    "./embed": {
      "types": "./src/embed/api.d.ts",
      "default": "./src/embed/index.ts"
    },
    "./embed-build": "./scripts/embed-build.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,html,css}\" \"test/**/*.mjs\" \"scripts/**/*.mjs\" \"*.{json,yaml,mjs}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css}\" \"test/**/*.mjs\" \"scripts/**/*.mjs\" \"*.{json,yaml,mjs}\"",
    "test": "node --test --test-timeout=180000 test/unit.test.mjs test/ws.test.mjs",
    "test:unit": "pnpm build && node --test --test-timeout=180000 test/unit.test.mjs test/ws.test.mjs",
    "check": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm build && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/chrome": "0.3.0",
    "@types/node": "26.6.3",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "linkedom": "0.18.13",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  },
  "dependencies": {
    "fflate": "0.8.3"
  }
}
