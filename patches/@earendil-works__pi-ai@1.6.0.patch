+// A model sometimes calls a grammar tool (one string input, sent as custom_tool_call) as a JSON
+// function_call whose arguments are the raw input text. That text is not JSON, so the call kept
+// `{}` and every later replay threw "requires argument ... to be a string", failing the run.
+// Keep the raw text as the tool's input: the call runs with what the model wrote.
+export function recoverGrammarFunctionCall(block, rawArguments, grammarToolInputProperties) {
+    const property = grammarToolInputProperties?.get(block.name);
+    if (property === undefined)
+        return;
+    const args = block.arguments && typeof block.arguments === "object" ? block.arguments : {};
+    if (typeof args[property] === "string")
+        return;
+    const received = /\n\nReceived arguments:\n([\s\S]*)$/.exec(block.argumentsError ?? "")?.[1];
+    const raw = typeof rawArguments === "string" && rawArguments ? rawArguments : received ?? "";
+    block.arguments = { ...args, [property]: raw };
+    delete block.argumentsError;
+}
