{
  "name": "aeon-video-kit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Remotion starter kit for Aeon recordings. Not part of Aeon's build.",
  "scripts": {
    "still": "remotion still src/Root.tsx Video out/frame.png --frame=30",
    "render": "remotion render src/Root.tsx Video out/video.mp4",
    "render:vertical": "remotion render src/Root.tsx VideoVertical out/video-vertical.mp4",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.535",
    "@remotion/cli": "^4.0.535"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "typescript": "^5.7.0"
  }
}
