{
  "name": "aeon-video-kit",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Aeon Director's Studio: Remotion kit for cinema-grade Aeon films. Not part of Aeon's build.",
  "scripts": {
    "studio": "remotion studio src/Root.tsx",
    "still": "remotion still src/Root.tsx DirectorCut out/still.png --frame=60",
    "still:square": "remotion still src/Root.tsx DirectorSquare out/still-square.png --frame=60",
    "audio": "node scripts/generate-audio.mjs",
    "lint:edit": "node scripts/lint-edit.mjs",
    "render": "node scripts/render.mjs DirectorCut",
    "render:square": "node scripts/render.mjs DirectorSquare",
    "render:raw": "node scripts/render.mjs RecordingRaw --no-lint",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.535",
    "@remotion/cli": "^4.0.535"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "typescript": "^5.7.0"
  }
}
