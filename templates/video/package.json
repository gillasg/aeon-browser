{
  "name": "aeon-video-kit",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Aeon Open Studio: a blank Remotion canvas around a real aeon record take. Not part of Aeon's build.",
  "scripts": {
    "studio": "remotion studio src/Root.tsx",
    "stills": "node scripts/render.mjs Scene --still-ms 0,2000,6000",
    "render": "node scripts/render.mjs Scene",
    "render:raw": "node scripts/render.mjs RecordingRaw",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@remotion/bundler": "^4.0.535",
    "@remotion/cli": "^4.0.535",
    "@remotion/renderer": "^4.0.535",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.535"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "typescript": "^5.7.0"
  }
}
